storage/backups/

# Self-hosted twemoji SVGs: regenerated from the npm package at build time if
# the emoji feature is used, so they are never committed (3,700+ files).
/public/twemoji/

# Local database backups (never commit: real data, large binaries)
storage/backups/

# Failure screenshots written by Pest browser tests, not artefacts to keep.
/tests/Browser/Screenshots/

# Scratch snapshots written by the Playwright MCP server.
/.playwright-mcp/

/docs/superpowers/

# Scratch screenshots dropped at the repo root, never part of the app.
/*.png

# Images fetched from third parties at runtime and written straight to disk:
# favicons by links:favicons, brand marks by airlines:logos and
# fuel:brand-logos, and avatars by code that no longer runs but whose directory
# reappears on machines that once did.
#
# All are cache rather than source: re-derivable from the API they came from,
# and every fetch command skips what is already there, so running one again
# costs nothing. They survive a deploy because a deploy updates this checkout
# in place rather than building a fresh one; run the fetch commands after
# deploying to refill anything missing.
/public/avatars/
/public/favicons/
/public/logos/
