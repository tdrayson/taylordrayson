storage/backups/

# Self-hosted twemoji SVGs: regenerated from the npm package at build time if
# the emoji feature is used, so they are never committed (3,700+ files).
/public/twemoji/

# Local database backups (never commit: real data, large binaries)
storage/backups/

# Failure screenshots written by Pest browser tests, not artefacts to keep.
/tests/Browser/Screenshots/

# Scratch snapshots written by the Playwright MCP server.
/.playwright-mcp/

/docs/superpowers/

# Scratch screenshots dropped at the repo root, never part of the app.
/*.png

# Avatar images cached at runtime, keyed by a hash of their source. Nothing in
# the app writes them any more, but the directory reappears on machines that
# ran the older code.
/public/avatars/

# Favicons downloaded at runtime by links:favicons, keyed by host. Fetched on
# the server, so they are cache rather than source.
/public/favicons/

# Bloom's workspace identifier, written into the checkout by the local tooling.
/.bloom-site
