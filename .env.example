APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Wall-clock timezone entries are recorded and displayed in.
APP_HOME_TIMEZONE=Europe/London

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2, the attachment store in production. Leave blank locally and
# MEDIA_DISK stays on the public disk.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=
R2_ENDPOINT=
R2_URL=

# Where Media Library writes. Set to r2 in production, once R2_* is filled in.
MEDIA_DISK=public
# Imagick handles the WebP conversions; the gd default cannot.
IMAGE_DRIVER=imagick

VITE_APP_NAME="${APP_NAME}"

LOGOSTREAM_KEY=

LOGODEV_TOKEN=

MAPBOX_TOKEN=
VITE_MAPBOX_TOKEN="${MAPBOX_TOKEN}"

POCKETCASTS_EMAIL=
POCKETCASTS_PASSWORD=

# Bearer token for the whole /api/v1 group, including the health-export push.
API_TOKEN=

TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
TRAKT_USERNAME=

TMDB_API_KEY=
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p/

HARDCOVER_API_KEY=

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

FOURSQUARE_ACCESS_TOKEN=

ROVI_KEY=
ROVI_BASE_URL=https://europe-west1-rovi-16b3a.cloudfunctions.net/personalApi

# Bump to bust cached OG images after changing how they are rendered.
OG_VERSION=1

# Browsershot renders the OG images and needs a real Chrome. Leave blank to use
# whatever is on PATH; set explicitly where the binaries are not discoverable,
# which is usually the case under a web server.
BROWSERSHOT_NODE_BINARY=
BROWSERSHOT_NPM_BINARY=
BROWSERSHOT_CHROME_PATH=
