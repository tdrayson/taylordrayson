@hugeicons-pro:registry=https://npm.hugeicons.com/
//npm.hugeicons.com/:_authToken=${HUGEICONS_TOKEN}

# Minimum release age (in days) for newly published packages.
# Delays installs of brand-new versions to reduce exposure to npm
# supply-chain / malware attacks. Requires npm >= 11.10.0.
min-release-age=7
