# The Hugeicons Pro registry. The token that authenticates against it is
# deliberately absent: it belongs in ~/.npmrc, which npm merges with this file
# and which is never committed.
#
#   ~/.npmrc
#   //npm.hugeicons.com/:_authToken=<token>
@hugeicons-pro:registry=https://npm.hugeicons.com/

# Minimum release age (in days) for newly published packages.
# Delays installs of brand-new versions to reduce exposure to npm
# supply-chain / malware attacks. Requires npm >= 11.10.0.
min-release-age=7
